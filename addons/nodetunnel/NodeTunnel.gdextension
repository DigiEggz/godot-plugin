[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"

[libraries]
linux.x86_64 = "res://addons/nodetunnel/bin/linux/x86_64/libnodetunnel.so"
linux.arm64 = "res://addons/nodetunnel/bin/linux/arm64/libnodetunnel.so"
windows.x86_64 = "res://addons/nodetunnel/bin/windows/x86_64/nodetunnel.dll"
windows.arm64 = "res://addons/nodetunnel/bin/windows/arm64/nodetunnel.dll"
macos = "res://addons/nodetunnel/bin/macos/libnodetunnel.dylib"
android.aarch64 = "res://addons/nodetunnel/bin/android/arm64-v8a/libnodetunnel.so"
android.x86_64 = "res://addons/nodetunnel/bin/android/x86_64/libnodetunnel.so"
